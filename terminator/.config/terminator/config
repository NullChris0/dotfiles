[global_config]
[keybindings]
  go_up = ""
  go_down = ""
  go_left = ""
  go_right = ""
[profiles]
  [[default]]
    background_color = "#2e3436"
    background_darkness = 0.86
    font = FiraCode Nerd Font Mono 18
    foreground_color = "#ffffff"
    show_titlebar = False
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
